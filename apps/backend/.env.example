# Local development only. Replace every secret for a deployed environment.
NODE_ENV=development
APP_NAME=OneCall
APP_VERSION=0.1.0
API_PREFIX=api/v1
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=0
DATABASE_URL=postgresql://onecall_local:onecall_local_only@127.0.0.1:54329/onecall_pilot
DATABASE_POOL_SIZE=10
REDIS_URL=redis://127.0.0.1:63799/0
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-this-with-another-random-secret-of-at-least-32-characters
PAYMENT_WEBHOOK_SECRET=replace-this-with-a-random-webhook-secret-of-at-least-32-characters
THROTTLE_GLOBAL_LIMIT=100
THROTTLE_GLOBAL_TTL_MS=60000
THROTTLE_KEY_PREFIX=onecall:throttle:
# For a Flutter web client only, list exact origins separated by commas.
CORS_ORIGINS=
# Required outside development to send email/SMS/reset challenges.
# Operator-owned HTTPS adapter; see docs/KADUNA-PILOT.md for the signed contract.
AUTH_DELIVERY_URL=
AUTH_DELIVERY_SECRET=

# Hosted checkout; keep empty until your payment account is configured.
PAYSTACK_SECRET_KEY=
# Funding requires explicit enablement. Read docs/NIGERIA.md before using live money.
ONECALL_WALLET_ENABLED=false
