# Copy to apps/backend/.env.delivery and configure outside version control.
# This process sends real messages when supplied with real provider credentials.
AUTH_DELIVERY_HOST=127.0.0.1
AUTH_DELIVERY_PORT=3010
# Same fresh random value as the backend AUTH_DELIVERY_SECRET (32+ characters).
AUTH_DELIVERY_SECRET=
# Persistent Redis, separate namespace from throttling. Use rediss:// for remote TLS.
AUTH_DELIVERY_REDIS_URL=redis://127.0.0.1:63799/0
AUTH_DELIVERY_REDIS_PREFIX=onecall:delivery:v1:
RESEND_API_KEY=
# Email address on a domain verified in Resend.
AUTH_EMAIL_FROM=
# Optional legacy SMS delivery is disabled; email is the required verification factor.
ONECALL_SMS_ENABLED=false
TERMII_API_KEY=
# Exact HTTPS origin from the Termii dashboard, for example https://api.ng.termii.com
TERMII_BASE_URL=
# Approved alphanumeric sender, 3–11 characters; OTP uses the DND route.
TERMII_SENDER_ID=
