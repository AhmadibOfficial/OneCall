# Runtime values only; do not commit the populated private file.
NODE_ENV=production
HOST=0.0.0.0
PORT=10000
APP_NAME=OneCall
APP_VERSION=0.1.0
API_PREFIX=api/v1
TRUST_PROXY=1
DATABASE_URL=
DATABASE_POOL_SIZE=5
REDIS_URL=
JWT_SECRET=
JWT_REFRESH_SECRET=
PAYMENT_WEBHOOK_SECRET=
THROTTLE_KEY_PREFIX=onecall:staging:throttle:
CORS_ORIGINS=
AUTH_DELIVERY_URL=
# Render can instead provide the delivery service's real HTTPS origin automatically.
AUTH_DELIVERY_ORIGIN=
AUTH_DELIVERY_SECRET=
# Attach a persistent private disk before enabling uploads.
ONECALL_UPLOADS_ENABLED=true
ONECALL_STORAGE_PERSISTENT=true
ONECALL_UPLOAD_ROOT=/var/lib/onecall/private
# Enable only for a single-instance preview; paid deployments use a pre-deploy migration.
ONECALL_MIGRATE_ON_START=false
ONECALL_SOCIAL_LOGIN_ENABLED=false
ONECALL_WALLET_ENABLED=false
# Set test for Paystack sandbox; live requires operator activation and live credentials.
ONECALL_PAYMENT_MODE=disabled
ONECALL_PAYMENTS_LIVE_APPROVED=false
# Render derives the return URL from its actual API service URL. Override for a verified custom domain.
PAYSTACK_CALLBACK_URL=
PAYSTACK_SECRET_KEY=
