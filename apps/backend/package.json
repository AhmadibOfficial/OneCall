{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node scripts/start-production.cjs",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-pilot.json --runInBand",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset",
    "prisma:studio": "prisma studio",
    "prisma:validate": "prisma validate",
    "prisma:push": "prisma db push",
    "prisma:pull": "prisma db pull",
    "pilot:provider": "node scripts/provision-pilot-provider.cjs",
    "auth:delivery": "node scripts/start-auth-delivery.cjs",
    "test:delivery": "node --test --test-concurrency=1 test/auth-delivery-adapter.test.cjs test/auth-delivery-production.test.cjs",
    "test:pilot": "jest --config ./test/jest-pilot.json --runInBand",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:delivery": "eslint scripts/auth-delivery/adapter.cjs scripts/start-auth-delivery.cjs scripts/verify-native-services.cjs test/auth-delivery-adapter.test.cjs test/auth-delivery-production.test.cjs",
    "lint:pilot": "eslint src/modules/auth/auth.service.ts src/modules/auth/auth-delivery.ts src/modules/auth/account-policy.ts src/modules/auth/strategies/jwt.strategy.ts src/modules/auth/guards/verified-account.guard.ts src/bootstrap/configure-application.ts src/bootstrap/app.module.ts src/infrastructure/database/prisma/prisma.service.ts src/modules/services/services.module.ts test/pilot.e2e-spec.ts test/setup.ts",
    "provider:approve": "node scripts/approve-provider.cjs",
    "support:ops": "node scripts/support-operations.cjs",
    "test:nigeria": "jest --config ./test/jest-nigeria.json --runInBand",
    "lint:nigeria": "eslint src/modules/marketplace src/modules/services/nigeria.ts src/modules/order scripts/approve-provider.cjs scripts/provision-pilot-provider.cjs scripts/support-operations.cjs test/nigeria.e2e-spec.ts test/provider-operations.test.cjs",
    "test:operations": "node --test --test-concurrency=1 test/provider-operations.test.cjs",
    "test:admin": "jest --config ./test/jest-admin.json --runInBand",
    "test:legal": "node --test test/legal-public.test.cjs",
    "test:social": "jest --config ./test/jest-social.json --runInBand"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs-redis/client": "^2.0.1",
    "@nestjs-redis/throttler-storage": "^2.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "joi": "^18.2.9",
    "multer": "2.4.0",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.2",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../test/tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/../test/setup.ts"
    ]
  }
}
