generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFIED
  PHONE_VERIFIED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  REFRESH_TOKEN_REVOKED
  EMAIL_VERIFICATION_FAILED
  PHONE_VERIFICATION_FAILED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum UploadPurpose {
  AVATAR
}

model StoredUpload {
  id String @id @default(uuid()) @db.Uuid

  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  purpose UploadPurpose

  storageKey   String @unique @db.VarChar(255)
  detectedMime String @db.VarChar(100)

  byteSize Int
  sha256   String @db.Char(64)

  createdAt DateTime @default(now())

  @@index([ownerId])
  @@index([purpose])
  @@index([createdAt])
}

model User {
  /// Internal database identifier.
  /// Never expose this as the normal public user identifier.
  id String @id @default(uuid()) @db.Uuid

  /// Public application identifier.
  /// Generated by the application layer.
  uid String @unique @db.VarChar(10)

  // Identity
  email String @unique
  phone String @unique

  passwordHash String

  firstName String
  lastName  String

  avatarUrl String?

  // Account status
  status AccountStatus @default(PENDING)

  // Verification
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  phoneVerified   Boolean   @default(false)
  phoneVerifiedAt DateTime?

  // Authentication security
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  tokenVersion        Int       @default(0)
  refreshTokenHash    String?
  lastLoginAt         DateTime?

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  roles UserRole[]

  uploads StoredUpload[]

  addresses Address[]

  providers Provider[]

  customerOrders Order[] @relation("CustomerOrders")

  sessions Session[]
  socialIdentities SocialIdentity[]
  bookingPhotos BookingPhoto[]

  verificationTokens VerificationToken[]

  passwordResetTokens PasswordResetToken[]

  securityEvents SecurityEvent[]

  favorites Favorite[]
  notifications Notification[]
  wallet Wallet?
  checkouts CheckoutIntent[]
  messages OrderMessage[]
  supportTickets SupportTicket[]
  parcelAgent ParcelAgent?
  parcels ParcelShipment[] @relation("ParcelSender")
  parcelEvents ParcelEvent[] @relation("ParcelEventActor")

  @@index([status])
  @@index([uid])
  @@index([deletedAt])
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Address {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  label        String
  addressLine1 String
  addressLine2 String?

  city  String
  state String
  lga   String?

  landmark String?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isDefault])
}

model Provider {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  orders Order[] @relation("ProviderOrders")

  approved Boolean @default(false)
  displayName String? @db.VarChar(120)
  vehicleDescription String? @db.VarChar(160)
  coverage ProviderCoverage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
  @@index([userId])
}

model Order {
  photos BookingPhoto[]
  id String @id @default(uuid()) @db.Uuid

  customerId String  @db.Uuid
  providerId String? @db.Uuid

  customer User      @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  provider Provider? @relation("ProviderOrders", fields: [providerId], references: [id], onDelete: SetNull)

  serviceName String  @db.VarChar(120)
  city        String  @default("Kaduna") @db.VarChar(60)
  state       String  @default("Kaduna") @db.VarChar(40)
  cityKey     String  @default("kaduna") @db.VarChar(60)
  address     String? @db.VarChar(300)
  description String? @db.Text
  pickupAddress String? @db.VarChar(300)
  destinationAddress String? @db.VarChar(300)
  scheduledAt DateTime?
  vehicleType String? @db.VarChar(20)
  quoteRequired Boolean @default(false)

  // Server-controlled. Never accept from the client.
  amount Decimal? @db.Decimal(12, 2)

  status OrderStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[] @relation("OrderPayments")
  quote OrderQuote?
  location OrderLocation?
  messages OrderMessage[]
  notifications Notification[]
  checkouts CheckoutIntent[]

  @@index([customerId])
  @@index([providerId])
  @@index([status])
  @@index([customerId, createdAt])
  @@index([providerId, createdAt])
  @@index([status, providerId])
  @@index([state, cityKey, serviceName, status])
}

model ProviderCoverage {
  id String @id @default(uuid()) @db.Uuid
  providerId String @db.Uuid
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  state String @db.VarChar(40)
  cityKey String @db.VarChar(60)
  serviceName String @db.VarChar(120)
  @@unique([providerId, state, cityKey, serviceName])
  @@index([state, cityKey, serviceName])
}

model Favorite {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceName String @db.VarChar(120)
  createdAt DateTime @default(now())
  @@unique([userId, serviceName])
}

model Notification {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId String? @db.Uuid
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  title String @db.VarChar(120)
  body String @db.VarChar(500)
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model OrderQuote {
  id String @id @default(uuid()) @db.Uuid
  orderId String @unique @db.Uuid
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount Decimal @db.Decimal(12, 2)
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderLocation {
  orderId String @id @db.Uuid
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  latitude Float
  longitude Float
  accuracy Float
  updatedAt DateTime @updatedAt
}

model OrderMessage {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId String @db.Uuid
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)
  text String @db.VarChar(1000)
  createdAt DateTime @default(now())
  @@index([orderId, createdAt])
}

model Wallet {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  balanceKobo BigInt @default(0)
  entries WalletEntry[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletEntry {
  id String @id @default(uuid()) @db.Uuid
  walletId String @db.Uuid
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  reference String @unique @db.VarChar(160)
  amountKobo BigInt
  description String @db.VarChar(160)
  createdAt DateTime @default(now())
  @@index([walletId, createdAt])
}

model CheckoutIntent {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderId String? @db.Uuid
  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  amountKobo BigInt
  reference String @unique @db.VarChar(128)
  idempotencyKey String @unique @db.VarChar(128)
  checkoutUrl String? @db.VarChar(500)
  status String @default("INITIALIZING") @db.VarChar(20)
  paidAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, createdAt])
  @@index([orderId, status])
}

model Session {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  selector     String @unique
  tokenHash    String
  attemptCount Int    @default(0)

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
}

model VerificationToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  selector  String @unique
  tokenHash String

  attemptCount Int                   @default(0)
  type         VerificationTokenType

  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, type])
}

model PasswordResetToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  selector  String @unique
  tokenHash String

  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model SecurityEvent {
  id String @id @default(uuid()) @db.Uuid

  userId String? @db.Uuid

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  type SecurityEventType

  ipAddress String?
  userAgent String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model Payment {
  id String @id @default(uuid()) @db.Uuid

  orderId String @db.Uuid

  webhookEvents PaymentWebhookEvent[] @relation("PaymentWebhookEvents")

  order Order @relation("OrderPayments", fields: [orderId], references: [id], onDelete: Restrict)

  amount Decimal @db.Decimal(12, 2)

  currency String @db.Char(3)

  status PaymentStatus @default(INITIATED)
  method String? @db.VarChar(20)

  idempotencyKey String @unique @db.VarChar(128)

  providerReference String? @unique @db.VarChar(255)

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([orderId, status])
  @@index([createdAt])
}

model PaymentWebhookEvent {
  id String @id @default(uuid()) @db.Uuid

  // Signed provider event identifier; this is the webhook idempotency key.
  eventId String @unique @db.VarChar(128)

  eventType String @db.VarChar(64)

  paymentId String?  @db.Uuid
  payment   Payment? @relation("PaymentWebhookEvents", fields: [paymentId], references: [id], onDelete: SetNull)

  providerReference String? @db.VarChar(255)

  // SHA-256 of the exact signed raw request body.
  payloadHash String @db.Char(64)

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([paymentId])
  @@index([providerReference])
  @@index([receivedAt])
}

model SupportTicket {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject String @db.VarChar(120)
  message String @db.VarChar(2000)
  status String @default("OPEN") @db.VarChar(20)
  response String? @db.VarChar(2000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, createdAt])
}

// Append-only operations history; actor identity survives account removal.
model AdminOperation {
  id String @id @default(uuid()) @db.Uuid
  actorId String @db.Uuid
  action String @db.VarChar(60)
  resourceId String @db.Uuid
  reason String @db.VarChar(500)
  details Json
  createdAt DateTime @default(now())
  @@index([resourceId, createdAt])
  @@index([actorId, createdAt])
}

model SocialIdentity {
  appleRefreshEncrypted String?
  appleClientId String?
  authorizedAt DateTime @default(now())
  lastCheckedAt DateTime?
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  provider String @db.VarChar(12)
  subject String @db.VarChar(255)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, subject])
  @@unique([userId, provider])
}

model SocialAuthChallenge {
  id String @id @default(uuid()) @db.Uuid
  browser Boolean @default(false)
  bindingUserId String? @db.Uuid
  bindingVersion Int?
  resultEncrypted String?
  deliveredAt DateTime?
  secretHash String @db.VarChar(64)
  provider String @db.VarChar(12)
  nonce String @db.VarChar(64)
  expiresAt DateTime
  verifiedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  @@index([expiresAt])
}

model BookingPhoto {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  uploaderId String @db.Uuid
  storageKey String @unique @db.VarChar(255)
  mime String @db.VarChar(100)
  byteSize Int
  createdAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  @@index([orderId])
  @@index([uploaderId, createdAt])
}

model AppleNoticeReceipt {
  id String @id @db.Char(64)
  createdAt DateTime @default(now())
}

enum ParcelAgentStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum ParcelRouteStatus {
  PENDING
  ACTIVE
  PAUSED
}

enum ParcelStatus {
  REQUESTED
  ACCEPTED
  AT_ORIGIN
  IN_TRANSIT
  READY_FOR_COLLECTION
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURN_IN_TRANSIT
  READY_FOR_RETURN
  RETURNED
}

model ParcelAgent {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  shopName String @db.VarChar(120)
  address String @db.VarChar(300)
  state String @db.VarChar(40)
  city String @db.VarChar(60)
  cityKey String @db.VarChar(60)
  status ParcelAgentStatus @default(PENDING)
  reviewReference String? @db.VarChar(120)
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  originRoutes ParcelRoute[] @relation("ParcelOriginRoute")
  destinationRoutes ParcelRoute[] @relation("ParcelDestinationRoute")
  outgoing ParcelShipment[] @relation("ParcelOriginShipment")
  incoming ParcelShipment[] @relation("ParcelDestinationShipment")
  @@index([status, state, cityKey])
}

model ParcelRoute {
  id String @id @default(uuid()) @db.Uuid
  originAgentId String @db.Uuid
  destinationAgentId String @db.Uuid
  originAgent ParcelAgent @relation("ParcelOriginRoute", fields: [originAgentId], references: [id], onDelete: Restrict)
  destinationAgent ParcelAgent @relation("ParcelDestinationRoute", fields: [destinationAgentId], references: [id], onDelete: Restrict)
  priceKobo Int
  maxWeightGrams Int
  estimatedHours Int
  homePickup Boolean @default(false)
  homePickupFeeKobo Int @default(0)
  status ParcelRouteStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shipments ParcelShipment[]
  @@index([originAgentId, status])
  @@index([destinationAgentId, status])
}

model ParcelShipment {
  id String @id @default(uuid()) @db.Uuid
  reference String @unique @db.VarChar(30)
  senderId String @db.Uuid
  sender User @relation("ParcelSender", fields: [senderId], references: [id], onDelete: Restrict)
  clientReference String @db.Uuid
  requestHash String @db.Char(64)
  routeId String @db.Uuid
  route ParcelRoute @relation(fields: [routeId], references: [id], onDelete: Restrict)
  originAgentId String @db.Uuid
  destinationAgentId String @db.Uuid
  originAgent ParcelAgent @relation("ParcelOriginShipment", fields: [originAgentId], references: [id], onDelete: Restrict)
  destinationAgent ParcelAgent @relation("ParcelDestinationShipment", fields: [destinationAgentId], references: [id], onDelete: Restrict)
  recipientName String @db.VarChar(120)
  recipientPhone String @db.VarChar(20)
  description String @db.VarChar(1000)
  category String @db.VarChar(30)
  weightGrams Int
  pickupMode String @db.VarChar(20)
  pickupAddress String? @db.VarChar(300)
  priceKobo Int
  policyVersion String @default("parcel-pilot-v1") @db.VarChar(40)
  status ParcelStatus @default(REQUESTED)
  version Int @default(0)
  codeHash String? @db.Char(64)
  codeExpiresAt DateTime?
  codeAttempts Int @default(0)
  codePurpose String? @db.VarChar(10)
  codeIssues Int @default(0)
  codeIssuedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events ParcelEvent[]
  @@unique([senderId, clientReference])
  @@index([senderId, createdAt])
  @@index([recipientPhone, createdAt])
  @@index([originAgentId, status])
  @@index([destinationAgentId, status])
}

model ParcelEvent {
  id String @id @default(uuid()) @db.Uuid
  shipmentId String @db.Uuid
  shipment ParcelShipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  actorId String @db.Uuid
  actor User @relation("ParcelEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  kind String @db.VarChar(40)
  status ParcelStatus
  note String @db.VarChar(500)
  createdAt DateTime @default(now())
  @@index([shipmentId, createdAt])
}
