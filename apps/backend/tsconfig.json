{
  "compilerOptions": {
    "target": "ES2023",

    "module": "Node16",
    "moduleResolution": "Node16",

    "lib": ["ES2023"],

    "declaration": true,
    "sourceMap": true,
    "removeComments": true,

    "incremental": false,

    "outDir": "./dist",
    "rootDir": "./src",

    "baseUrl": ".",

    "paths": {
      "@/*": ["./src/*"]
    },

    "resolvePackageJsonExports": true,
    "resolveJsonModule": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "strict": true,

    "skipLibCheck": true
  },

  "include": ["src"],

  "exclude": [
    "dist",
    "node_modules",
    "test"
  ]
}