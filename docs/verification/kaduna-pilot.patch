+        'serviceName': 'Tailoring',
+        'address': 'Unguwan Rimi, Kaduna',
+        'description': 'Alter a kaftan',
+      });
+      return jsonResponse({
+        'id': 'order-1',
+        'serviceName': 'Tailoring',
+        'status': 'PENDING',
+        'city': 'Kaduna',
+        'createdAt': '2026-10-09T12:00:00.000Z',
+        'amount': null,
+        'providerAssigned': false,
+      }, 201);
+    });
+    addTearDown(api.dispose);
+    await api.restore();
+    final servicesApi = client(
+      MemoryStore(),
