+}
+
+class OrderPage extends StatefulWidget {
+  const OrderPage({super.key, required this.api, required this.initialOrder});
+  final OneCallApi api;
+  final ServiceOrder initialOrder;
+  @override
+  State<OrderPage> createState() => _OrderPageState();
+}
+
+class _OrderPageState extends State<OrderPage> with WidgetsBindingObserver {
+  late ServiceOrder _order;
+  Timer? _timer;
+  bool _busy = false;
+  String? _error;
+  @override
+  void initState() {
+    super.initState();
+    _order = widget.initialOrder;
+    WidgetsBinding.instance.addObserver(this);
+    _startPolling();
+    unawaited(_refresh());
+  }
+
+  void _startPolling() {
+    _timer?.cancel();
+    if (!_order.isFinished) {
+      _timer = Timer.periodic(const Duration(seconds: 15), (_) {
+        if (!_busy) {
+          unawaited(_refresh());
+        }
+      });
+    }
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    if (state == AppLifecycleState.resumed) {
+      _startPolling();
+      unawaited(_refresh());
+    } else {
+      _timer?.cancel();
+    }
+  }
+
+  Future<void> _refresh() async {
+    if (_busy) {
+      return;
+    }
+    setState(() {
+      _busy = true;
+    });
+    try {
+      final order = await widget.api.order(_order.id);
+      if (mounted) {
+        setState(() {
+          _order = order;
+          _error = null;
+          if (order.isFinished) {
+            _timer?.cancel();
+          }
+        });
+      }
+    } catch (error) {
+      if (mounted) {
+        setState(() {
+          _error = errorMessage(error);
+        });
+      }
+    } finally {
+      if (mounted) {
+        setState(() {
+          _busy = false;
+        });
+      }
+    }
+  }
+
+  Future<void> _cancel() async {
+    final confirmed = await showDialog<bool>(
+      context: context,
+      builder: (context) => AlertDialog(
+        title: const Text('Cancel this request?'),
+        content: const Text(
+          'The provider will no longer be able to continue this request.',
+        ),
+        actions: [
+          TextButton(
+            onPressed: () => Navigator.pop(context, false),
+            child: const Text('Keep request'),
+          ),
+          FilledButton(
+            onPressed: () => Navigator.pop(context, true),
+            child: const Text('Cancel request'),
+          ),
+        ],
+      ),
+    );
+    if (confirmed != true || !mounted) {
+      return;
+    }
+    setState(() {
+      _busy = true;
+      _error = null;
+    });
+    try {
+      final result = await widget.api.cancelOrder(_order.id);
+      if (mounted) {
+        setState(() {
+          _order = result;
+          _timer?.cancel();
+        });
+      }
+    } catch (error) {
+      if (mounted) {
+        setState(() {
+          _error = errorMessage(error);
+        });
+      }
+    } finally {
+      if (mounted) {
+        setState(() {
+          _busy = false;
+        });
+      }
+    }
+  }
+
+  @override
+  void dispose() {
+    _timer?.cancel();
+    WidgetsBinding.instance.removeObserver(this);
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) => Scaffold(
+    appBar: AppBar(
+      title: const Text('Request status'),
+      actions: [
+        IconButton(
+          tooltip: 'Refresh status',
+          onPressed: _busy ? null : _refresh,
+          icon: const Icon(Icons.refresh),
+        ),
+      ],
+    ),
+    body: RefreshIndicator(
+      onRefresh: _refresh,
+      child: ListView(
+        physics: const AlwaysScrollableScrollPhysics(),
+        padding: const EdgeInsets.all(24),
+        children: [
+          Text(
+            _order.serviceName,
+            style: const TextStyle(
+              fontSize: 28,
+              fontWeight: FontWeight.bold,
+              color: navy,
+            ),
+          ),
+          const SizedBox(height: 16),
+          Align(
+            alignment: Alignment.centerLeft,
+            child: StatusBadge(_order.status, _order.statusLabel),
+          ),
+          if (_busy)
+            const Padding(
+              padding: EdgeInsets.only(top: 12),
+              child: LinearProgressIndicator(),
+            ),
+          if (_error != null) ErrorNotice(_error!, onRetry: _refresh),
+          const SizedBox(height: 24),
+          Card(
+            child: Padding(
+              padding: const EdgeInsets.all(20),
+              child: Column(
+                crossAxisAlignment: CrossAxisAlignment.start,
+                children: [
+                  const Text(
+                    'Request details',
+                    style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
+                  ),
+                  const SizedBox(height: 14),
+                  Text('Service area: ${_order.city}'),
+                  const SizedBox(height: 12),
+                  Text(_order.address ?? 'Address not provided'),
+                  if ((_order.description ?? '').isNotEmpty) ...[
+                    const Divider(height: 28),
+                    Text(_order.description!),
+                  ],
+                  const Divider(height: 28),
+                  Text(
+                    _order.amount == null
+                        ? 'Price: awaiting a quote'
+                        : 'Price: NGN ${_order.amount}',
+                  ),
+                  const SizedBox(height: 12),
+                  Text(
+                    _order.providerAssigned
+                        ? 'A provider is assigned'
+                        : 'Waiting for a provider to accept',
+                  ),
+                  const SizedBox(height: 12),
+                  SelectableText(
+                    'Request ID: ${_order.id}',
+                    style: const TextStyle(fontSize: 12, color: Colors.black54),
+                  ),
+                ],
+              ),
+            ),
+          ),
+          const SizedBox(height: 24),
+          const Text(
+            'Progress',
+            style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
+          ),
+          if (_order.status == 'CANCELLED')
+            const ListTile(
+              leading: Icon(Icons.cancel_outlined),
+              title: Text('Request cancelled'),
+            )
+          else
+            ...[
+              'PENDING',
+              'ACCEPTED',
+              'IN_PROGRESS',
+              'COMPLETED',
+            ].asMap().entries.map((step) {
+              final current = [
+                'PENDING',
+                'ACCEPTED',
+                'IN_PROGRESS',
+                'COMPLETED',
+              ].indexOf(_order.status);
+              final done = step.key <= current;
+              return ListTile(
+                contentPadding: EdgeInsets.zero,
+                leading: Icon(
+                  done ? Icons.check_circle : Icons.radio_button_unchecked,
+                  color: done ? teal : Colors.grey,
+                ),
+                title: Text(
+                  [
+                    'Request sent',
+                    'Provider accepted',
+                    'Work in progress',
+                    'Completed',
+                  ][step.key],
+                  style: TextStyle(color: done ? navy : Colors.black54),
+                ),
+              );
+            }),
+          if (!_order.isFinished)
+            const Text(
+              'Status refreshes every 15 seconds while this screen is active.',
+              style: TextStyle(fontSize: 12, color: Colors.black54),
+            ),
+          if (_order.canCancel)
+            Padding(
+              padding: const EdgeInsets.only(top: 24),
+              child: OutlinedButton(
+                onPressed: _busy ? null : _cancel,
+                child: const Text('Cancel request'),
+              ),
+            ),
+        ],
+      ),
+    ),
+  );
+}
