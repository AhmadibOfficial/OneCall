+    () async {
+      final store = savedSession();
+      final api = client(
+        store,
+        (options) async => options.path == '/users/me'
+            ? jsonResponse({'user': profile})
+            : jsonResponse({'message': 'Invalid refresh token'}, 401),
+      );
