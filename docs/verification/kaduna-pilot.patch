+RESEND_API_KEY=
+# Email address on a domain verified in Resend.
+AUTH_EMAIL_FROM=
+TERMII_API_KEY=
+# Exact HTTPS origin from the Termii dashboard, for example https://api.ng.termii.com
+TERMII_BASE_URL=
+# Approved alphanumeric sender, 3–11 characters; OTP uses the DND route.
+TERMII_SENDER_ID=
